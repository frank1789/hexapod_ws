<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_servomotor</name>
  <version>0.1.0</version>
  <description>
    Drives the 18 hexapod servos through two Adafruit PCA9685 boards on the I2C
    bus. The motor table and the homing angles are described by Lua scripts in
    config/ and are read at runtime.
  </description>
  <maintainer email="francesco.argentieri89@gmail.com">Francesco Argentieri</maintainer>

  <author email="uni.lorenzo.a@gmail.com">Lorenzo Argentieri</author>
  <author email="francesco.argentieri89@gmail.com">Francesco Argentieri</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>hexapod_msgs</depend>
  <depend>rclcpp</depend>

  <!-- System dependencies: lua5.3 headers, sol2 and the i2c userspace library. -->
  <depend>liblua5.3-dev</depend>
  <depend>libi2c-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
