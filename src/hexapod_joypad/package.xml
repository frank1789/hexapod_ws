<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_joypad</name>
  <version>0.1.0</version>
  <description>
    Remaps the raw sensor_msgs/Joy stream of a PS3 controller into the semantic
    hexapod_msgs messages consumed by the rest of the robot.
  </description>
  <maintainer email="francesco.argentieri89@gmail.com">Francesco Argentieri</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hexapod_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <!-- joy replaces the ROS 1 ps3joy driver, which has no ROS 2 release. -->
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
