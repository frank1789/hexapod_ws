root = true

[*]
end_of_line = lf
indent_style = space
insert_final_newline = true
charset = utf-8

[*.{c, cc, cpp, cxx, h, hh, hpp, hxx}]
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4
trim_trailing_whitespace = true

[*.json]
indent_size = 4
trim_trailing_whitespace = true
