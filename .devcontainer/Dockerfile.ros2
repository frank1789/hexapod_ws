# syntax=docker/dockerfile:1
#
# Development image for hexapod_ws: ROS 2 + LLVM/clang toolchain, non-root user.
#
# Every version-specific value is an ARG and nothing below hard-codes a distro
# or a compiler version, so upgrading is a one-line change:
#
#   docker build -f .devcontainer/Dockerfile.ros2 -t hexapod-dev \
#       --build-arg ROS_DISTRO=kilted --build-arg LLVM_VERSION=22 .
#
# The build context is the root of the workspace, not .devcontainer, because
# vcpkg.json is resolved while the image is built. The same ARGs are surfaced in
# devcontainer.json.

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ARG ROS_DISTRO=jazzy
ARG LLVM_VERSION=21
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# ROS_DISTRO is exported, not just an ARG: entrypoint, .bashrc and postCreate
# all read it, so they stay distro-agnostic.
ENV ROS_DISTRO=${ROS_DISTRO} \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    SHELL=/bin/bash

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --------------------------------------------------------------- base system
# DEBIAN_FRONTEND is a build-time concern only, so it is exported per-RUN
# instead of leaking into the running container's environment.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash-completion \
        ca-certificates \
        cppcheck \
        curl \
        gdb \
        git \
        git-lfs \
        gnupg \
        locales \
        lsb-release \
        python3 \
        python3-pip \
        python3-venv \
        ssh \
        sudo \
        unzip \
        valgrind \
        wget \
        zip \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------ project build dependencies
# Deliberately the same set as docker/Dockerfile: zip, unzip and tar are vcpkg's
# own requirements, the rest is what the workspace needs to compile.
#
# Nothing declared in vcpkg.json is installed from apt. fmt, ZeroMQ, cppzmq,
# Eigen, sol2 and LuaJIT all come from the manifest, so this image resolves them
# exactly the way the image that ships to the robot does. An apt copy alongside
# would be a second, differently versioned answer to the same find_package(),
# and the dev container would stop predicting what the Pi builds.
#
# Two dependencies are not in the manifest and cannot be:
#   libi2c-dev     i2c-peripheral.cc includes <i2c/smbus.h> and the node links
#                  -li2c; these are kernel userspace bindings, vcpkg has no port
#   liblua5.3-dev  the fallback runtime when LuaJIT is unavailable, and the
#                  source of luac5.3, which the lua-syntax pre-commit hook runs
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        libi2c-dev \
        liblua5.3-dev \
        lua5.3 \
        ninja-build \
        pkg-config \
        tar \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------- ROS 2
# The ros-apt-source .deb installs the keyring and the sources.list entry for
# the running Ubuntu release, so no key handling is needed here.
RUN export DEBIAN_FRONTEND=noninteractive \
    && ROS_APT_SOURCE_VERSION="$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest \
        | grep -F '"tag_name"' | awk -F'"' '{print $4}')" \
    && curl -fsSL -o /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo "${VERSION_CODENAME}")_all.deb" \
    && apt-get update \
    && apt-get install -y /tmp/ros2-apt-source.deb \
    && rm -f /tmp/ros2-apt-source.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-joy \
        ros-${ROS_DISTRO}-joint-state-publisher-gui \
        ros-${ROS_DISTRO}-robot-state-publisher \
        ros-${ROS_DISTRO}-rviz2 \
        ros-${ROS_DISTRO}-xacro \
        ros-${ROS_DISTRO}-ament-copyright \
        ros-${ROS_DISTRO}-ament-flake8 \
        ros-${ROS_DISTRO}-ament-uncrustify \
        ros-dev-tools \
    && rosdep init \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------- LLVM/clang
# llvm.sh installs exactly ${LLVM_VERSION}; the alternatives loop is written
# against the same variable, so bumping LLVM_VERSION is the only edit needed.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && curl -fsSL https://apt.llvm.org/llvm.sh -o /tmp/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh ${LLVM_VERSION} \
    && apt-get install -y --no-install-recommends \
        clang-format-${LLVM_VERSION} \
        clang-tidy-${LLVM_VERSION} \
        clangd-${LLVM_VERSION} \
    && rm -f /tmp/llvm.sh \
    && for tool in clang clang++ clang-cpp clang-format clang-tidy clangd \
                   lld ld.lld llvm-ar llvm-config llvm-cov llvm-nm llvm-objcopy \
                   llvm-objdump llvm-profdata llvm-ranlib llvm-strip llvm-symbolizer; do \
           if [ -x "/usr/bin/${tool}-${LLVM_VERSION}" ]; then \
               update-alternatives --install "/usr/bin/${tool}" "${tool}" \
                   "/usr/bin/${tool}-${LLVM_VERSION}" 100; \
           fi; \
       done \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------ python dev tooling
# apt for what ROS imports from the system interpreter (ament_flake8 and the
# ament test harness), pipx — one isolated venv per tool — for the CLI tools.
# Plain `pip install` into the system environment fails on Ubuntu 24.04: it
# tries to uninstall Debian-managed packages such as `packaging` and cannot.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        pipx \
        python3-argcomplete \
        python3-flake8 \
        python3-pytest \
        python3-pytest-cov \
    && export PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin \
    && pipx install black \
    && pipx install commitizen \
    && pipx install isort \
    && pipx install pre-commit \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------- vcpkg
# The same arrangement as docker/Dockerfile, so a dependency behaves identically
# here and in the image that ships to the robot: one manifest (vcpkg.json), one
# installed tree, one triplet derived from the architecture doing the build.
#
# This is the only source of cppzmq, sol2 and LuaJIT in the image. Without it
# the bridge falls back to fetching cppzmq at configure time and the servo node
# to the reference Lua interpreter — both work, and both are the path with fewer
# eyes on them.
ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_INSTALLED=/opt/vcpkg_installed \
    VCPKG_DISABLE_METRICS=1

# master, as in docker/Dockerfile. vcpkg.json carries no builtin-baseline, so
# the commit checked out here is the version pin: pass the same
# --build-arg VCPKG_REF=<sha> to both images when that has to be reproducible.
# A baseline in the manifest would be the tidier way to say it and is not
# usable — see doc/simulation.md, "Pinning the dependency set".
ARG VCPKG_REF=master

# VCPKG_FORCE_SYSTEM_BINARIES is deliberately not set, and that is what makes
# this image build on an Apple Silicon Mac.
#
# vcpkg's own port scripts call string(JSON ... STRING_ENCODE), which arrived in
# CMake 3.31. Ubuntu 24.04 carries 3.28, so pointing vcpkg at the system CMake
# fails every port before it compiles a line — on arm64 exactly as on x86_64:
#
#   CMake Error at scripts/cmake/z_vcpkg_spdx.cmake:15 (string):
#     string sub-command JSON got an invalid mode 'STRING_ENCODE'
#
# Left unset, vcpkg downloads the CMake and Ninja it is tested against. It
# publishes both for linux/amd64 and linux/arm64 (scripts/vcpkg-tools.json), so
# an Intel Mac and an Apple Silicon Mac take the same path — and the system
# CMake stays at the version ROS and colcon are tested against, which is the
# other half of why nothing is upgraded here.
RUN git clone --depth 1 --branch "${VCPKG_REF}" https://github.com/microsoft/vcpkg.git "${VCPKG_ROOT}" \
    && "${VCPKG_ROOT}/bootstrap-vcpkg.sh" -disableMetrics

# Only the manifest is copied, so editing a source file never invalidates the
# layer that compiled the third-party libraries.
COPY vcpkg.json /tmp/vcpkg/vcpkg.json

RUN VCPKG_TRIPLET="$(uname -m | sed 's/aarch64/arm64-linux/; s/x86_64/x64-linux/')" \
    && echo "${VCPKG_TRIPLET}" > /opt/vcpkg_triplet \
    && "${VCPKG_ROOT}/vcpkg" install \
        --x-manifest-root=/tmp/vcpkg \
        --x-install-root="${VCPKG_INSTALLED}" \
        --triplet "${VCPKG_TRIPLET}" \
        --clean-after-build \
    && rm -rf /tmp/vcpkg /root/.cache/vcpkg /opt/vcpkg/buildtrees /opt/vcpkg/packages

# ------------------------------------------------------------ graphical tools
# Docker Desktop on macOS passes no GPU and no X socket into its virtual
# machine, so the container brings its own display: Xvfb draws, x11vnc exports
# it and websockify serves the noVNC client over HTTP. The Mac needs a browser
# and nothing else.
#
# fluxbox is not decoration. Without a window manager RViz and the joint slider
# window both open at the top-left corner with no title bar and cannot be moved
# or resized.
#
# mesa-utils carries glxinfo, which answers "is this really llvmpipe?" in one
# command instead of a guess. Nothing here is started by the image — see
# scripts/start-gui.sh.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        fluxbox \
        mesa-utils \
        novnc \
        websockify \
        x11-utils \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------- non-root user
# Ubuntu 24.04 ships a stock "ubuntu" account on UID 1000, which collides with
# the host UID we normally want. Free the requested UID/GID first so the
# bind-mounted /workspace stays writable without any chown.
RUN if getent passwd ${USER_UID} >/dev/null; then \
        userdel -r "$(getent passwd ${USER_UID} | cut -d: -f1)" 2>/dev/null || true; \
    fi \
    && if ! getent group ${USER_GID} >/dev/null; then \
        groupadd --gid ${USER_GID} ${USERNAME}; \
    fi \
    && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME} \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && mkdir -p /workspace \
    && chown ${USER_UID}:${USER_GID} /workspace

COPY --chmod=0755 .devcontainer/entrypoint.sh /usr/local/bin/entrypoint.sh

USER ${USERNAME}
WORKDIR /workspace

# Interactive shells get ROS and, once built, the workspace overlay.
# rosdep runs as the user because it writes into ${HOME}/.ros.
# AMENT_TRACE_SETUP_FILES is read by setup.bash but not defined; set it empty
# to prevent 'unbound variable' errors in strict shells.
RUN printf '%s\n' \
        'export AMENT_TRACE_SETUP_FILES="${AMENT_TRACE_SETUP_FILES:-}"' \
        "source /opt/ros/${ROS_DISTRO}/setup.bash" \
        'if [ -f /workspace/install/setup.bash ]; then source /workspace/install/setup.bash; fi' \
        'export RCUTILS_COLORIZED_OUTPUT=1' \
        'export RCUTILS_CONSOLE_OUTPUT_FORMAT="[{severity}] [{name}]: {message}"' \
        >> "${HOME}/.bashrc" \
    && rosdep update --rosdistro "${ROS_DISTRO}"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
